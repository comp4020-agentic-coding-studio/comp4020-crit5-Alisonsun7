---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Tri-Match"
  description="A tiny tile-matching game: clear the board before the tray fills up."
>
  <main>
    <h1 class="visually-hidden">Tri-Match</h1>
    <div id="board"></div>
    <div id="tray">
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
    </div>
    <div id="result" hidden>
      <p id="result-text"></p>
      <button id="restart" type="button" aria-label="restart">⟲</button>
    </div>
  </main>
  <script>
    import "../scripts/game";
  </script>
</BaseLayout>
