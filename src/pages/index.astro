---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Orchard Match"
  description="A tiny tile-matching game: clear the board before the tray fills up."
>
  <main>
    <h1 class="visually-hidden">Orchard Match</h1>
    <div id="board"></div>
    <div id="tray">
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
      <div class="tray-slot"></div>
    </div>
    <div id="result" hidden>
      <div id="confetti" aria-hidden="true"></div>
      <p id="result-icon" aria-hidden="true"></p>
      <p id="result-title"></p>
      <p id="result-text"></p>
      <button id="restart" type="button" aria-label="restart">⟲</button>
    </div>
  </main>
  <script>
    import "../scripts/game";
  </script>
</BaseLayout>
